{
  "type": "object",
  "additionalProperties": false,
  "required": ["shouldReply", "reply", "memories", "task"],
  "properties": {
    "shouldReply": { "type": "boolean" },
    "reply": { "type": "string" },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "label", "text"],
        "properties": { "subject": { "type": ["string", "null"] }, "label": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "task": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "prompt"],
          "properties": { "summary": { "type": "string" }, "prompt": { "type": "string" } }
        }
      ]
    }
  }
}
