# Three DIFFERENT random values, each at least 32 characters. Never commit .env.
ADMIN_TOKEN=replace-with-admin-secret-at-least-32-chars
ONEBOT_SECRET=replace-with-webhook-secret-at-least-32-chars
ONEBOT_TOKEN=replace-with-onebot-api-token-at-least-32-chars
# Comma-separated QQ user IDs. Empty means deny everyone.
ALLOWED_USERS=123456789
# Empty disables all group messages. Both user AND group must be allowed.
ALLOWED_GROUPS=
# Optional operator-owned creator and small-group roster. See config/identity.example.json.
COMPANION_IDENTITY_FILE=
# Wait after the latest message; commands seal the window. Maximum excludes busy queues.
PRIVATE_DEBOUNCE_MS=3000
GROUP_DEBOUNCE_MS=4000
CHAT_MAX_WAIT_MS=12000
# Native creation tools; install tools/artifacts/requirements.txt in an isolated venv first.
ENABLE_ARTIFACTS=false
ENABLE_IMAGE_GENERATION=false
ENABLE_FILE_DELIVERY=false
ENABLE_CROSS_CHAT_SEND=false
ARTIFACT_PYTHON=/opt/linux-contact-artifacts/venv/bin/python
ARTIFACT_RENDERER=
DAILY_ARTIFACTS=20
DAILY_IMAGES=3
IMAGE_TIMEOUT_MS=600000
MAX_UPLOAD_MB=20
QQ_WATCHDOG_STATUS_FILE=
# Operator-owned JSON files outside the repo. Never pass credentials to the model.
TTS_CONFIG_FILE=
MUSIC_CONFIG_FILE=
ENABLE_QQ_SOCIAL=false
HOST=127.0.0.1
PORT=3789
ONEBOT_URL=http://127.0.0.1:3000
DATA_DIR=./data
WORKSPACE_DIR=./workspace
TASKS_FILE=./config/tasks.json
ENABLE_TASKS=false
# api or codex. api supports Bailian, Ollama /v1 and vLLM /v1.
MODEL_BACKEND=codex
# Copy the exact compatible-mode Base URL from your Bailian workspace.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_MS=180000
# Native Linux only by default; see README for Codex mode.
CODEX_BIN=codex
CODEX_HOME=
CODEX_MODEL=
ENABLE_CODEX_WORK=true
CODEX_WORK_TIMEOUT_MS=300000
AUTO_MEMORY=true
REPLY_DELAY_MS=500
# Pin a tested release, e.g. v4.18.41, before enabling the qq Compose profile.
NAPCAT_TAG=
NAPCAT_UID=1000
NAPCAT_GID=1000
WEBUI_TOKEN=replace-with-webui-secret-at-least-32-chars
