# Placeholders only. Administrator creates .env separately; never deploy as-is.
ADMIN_TOKEN=replace-with-admin-token-at-least-32-characters
ONEBOT_SECRET=replace-with-http-client-signing-secret-at-least-32-characters
ONEBOT_TOKEN=replace-with-http-server-api-token-at-least-32-characters
WEBUI_TOKEN=replace-with-napcat-webui-token-at-least-32-characters
HOST=172.30.70.1
PORT=3789
MODEL_BACKEND=codex
CODEX_BIN=/usr/local/bin/codex
CODEX_HOME=/var/lib/linux-contact/.codex
CODEX_MODEL=
MODEL_TIMEOUT_MS=180000
ENABLE_CODEX_WORK=true
CODEX_WORK_TIMEOUT_MS=300000
AUTO_MEMORY=true
REPLY_DELAY_MS=500
ONEBOT_URL=http://127.0.0.1:3000
ALLOWED_USERS=
ALLOWED_GROUPS=
COMPANION_IDENTITY_FILE=
GROUP_DEBOUNCE_MS=1200
TTS_CONFIG_FILE=
MUSIC_CONFIG_FILE=
ENABLE_QQ_SOCIAL=false
DATA_DIR=/var/lib/linux-contact/app/data
WORKSPACE_DIR=/var/lib/linux-contact/app/workspace
TASKS_FILE=/var/lib/linux-contact/app/config/tasks.json
ENABLE_TASKS=false
# Container user IDs for the two Docker named volumes; no host directory bind.
NAPCAT_UID=1000
NAPCAT_GID=1000
